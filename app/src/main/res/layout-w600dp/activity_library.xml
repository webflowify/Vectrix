<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/md_surface"
            android:theme="@style/ThemeOverlay.Material3.ActionBar"
            app:title="Game Library"
            app:menu="@menu/menu_library" />

        <LinearLayout
            android:id="@+id/more_apps_slider_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/md_surface"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="2dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/more_apps_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_on_surface" />

                <TextView
                    android:id="@+id/more_apps_see_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/more_apps_see_all"
                    android:textSize="13sp"
                    android:textColor="@color/md_primary"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp"
                    android:foreground="?attr/selectableItemBackground" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_more_apps"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:clipToPadding="false"
                android:paddingHorizontal="12dp"
                android:paddingBottom="8dp"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical"
            android:background="@color/md_surface">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Search games..."
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:startIconDrawable="@drawable/ic_search"
                app:boxBackgroundColor="@color/md_surface_variant"
                android:layout_marginEnd="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/searchEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"
                    android:textColor="@color/md_on_surface"
                    android:textColorHint="@color/md_on_surface_variant" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filter_chip_group"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_title"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Title"
                    android:checked="true"
                    app:chipBackgroundColor="@color/md_surface_variant"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/md_outline"
                    app:checkedIconVisible="false"
                    android:textColor="@color/md_on_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_recently_played"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recently Played"
                    app:chipBackgroundColor="@color/md_surface_variant"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/md_outline"
                    app:checkedIconVisible="false"
                    android:textColor="@color/md_on_surface" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_recently_added"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recently Added"
                    app:chipBackgroundColor="@color/md_surface_variant"
                    app:chipStrokeWidth="1dp"
                    app:chipStrokeColor="@color/md_outline"
                    app:checkedIconVisible="false"
                    android:textColor="@color/md_on_surface" />

            </com.google.android.material.chip.ChipGroup>

        </LinearLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_games"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="32dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:contentDescription="@string/empty_state_icon_desc"
                android:src="@drawable/ic_gamepad"
                android:alpha="0.5" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/empty_state_title"
                android:textColor="@color/md_on_surface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/empty_state_subtitle"
                android:textColor="@color/md_on_surface_variant"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>

        <include layout="@layout/progress_overlay" />

    </FrameLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_add_rom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:text="Add Game"
        android:contentDescription="Add ROM"
        app:icon="@android:drawable/ic_input_add"
        app:backgroundTint="@color/md_primary"
        android:textColor="@color/md_on_primary" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>