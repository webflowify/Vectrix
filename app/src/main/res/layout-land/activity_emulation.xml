<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emulation_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_background">

    <!-- Game screen - full screen, always fills entire area -->
    <android.opengl.GLSurfaceView
        android:id="@+id/gl_surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Pause overlay -->
    <TextView
        android:id="@+id/pause_overlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="PAUSED"
        android:textSize="28sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/bg_pause_overlay"
        android:elevation="6dp"
        android:visibility="gone" />

    <!-- Virtual gamepad - overlaid at bottom of screen -->
    <com.tansoft.ps1emulator.input.VirtualGamepadView
        android:id="@+id/gamepad_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- Bottom-left pair (left to right): btnMenu → btnFullscreen, 20dp gap -->
    <ImageButton
        android:id="@+id/btnMenu"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/ic_menu_manage"
        android:background="@drawable/round_button_bg"
        android:contentDescription="Menu"
        android:elevation="4dp" />

    <ImageButton
        android:id="@+id/btnFullscreen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_fullscreen_enter"
        android:background="@drawable/round_button_bg"
        android:contentDescription="Toggle fullscreen"
        android:elevation="4dp" />

    <TextView
        android:id="@+id/fullscreen_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="64dp"
        android:textSize="12sp"
        android:textColor="@android:color/white"
        android:text=""
        android:visibility="gone" />

    <!-- Bottom-right control cluster (rightmost → leftward):
         btnFastForward → btnRewind → btnSlowMotion -->

    <ImageButton
        android:id="@+id/btnFastForward"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:src="@android:drawable/ic_media_ff"
        android:background="@drawable/round_button_bg"
        android:contentDescription="Fast Forward"
        android:elevation="4dp" />

    <TextView
        android:id="@+id/fast_forward_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="64dp"
        android:textSize="12sp"
        android:textColor="@color/neon_cyan"
        android:text=""
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnRewind"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="68dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_rewind"
        android:background="@drawable/round_button_bg"
        android:contentDescription="Rewind"
        android:elevation="4dp"
        android:saveEnabled="false" />

    <TextView
        android:id="@+id/rewind_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="68dp"
        android:layout_marginBottom="64dp"
        android:textSize="12sp"
        android:textColor="@color/neon_pink"
        android:text=""
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btnSlowMotion"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="124dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_slow_motion"
        android:background="@drawable/round_button_bg"
        android:contentDescription="Slow Motion"
        android:elevation="4dp" />

    <TextView
        android:id="@+id/slow_motion_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="124dp"
        android:layout_marginBottom="64dp"
        android:textSize="12sp"
        android:textColor="@color/neon_pink"
        android:text=""
        android:visibility="gone" />

    <include layout="@layout/progress_overlay" />

    <TextView
        android:id="@+id/fps_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="8dp"
        android:textSize="14sp"
        android:textColor="@color/neon_green"
        android:text="FPS: --"
        android:visibility="visible" />

</FrameLayout>
