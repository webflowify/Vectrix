<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="8dp"
    android:background="@drawable/controller_card_bg"
    android:padding="12dp">

    <TextView
        android:id="@+id/controllerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/md_on_surface"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/controllerId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="12sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/md_outline_variant"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap a button below to remap"
        android:textColor="@color/md_on_surface_variant"
        android:textSize="13sp" />

</LinearLayout>
